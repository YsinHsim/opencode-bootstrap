{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "rootsys": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Rootsys",
      "options": {
        "baseURL": "https://rootsys.cloud/v1",
        "apiKey": "{file:~/.config/opencode/rootsys.key}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        },
        "kimi-k2.7": {
          "name": "Kimi K2.7"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "minimax-m3": {
          "name": "MiniMax M3"
        },
        "mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro"
        },
        "hy4-preview": {
          "name": "Hunyuan 4 Preview"
        }
      }
    }
  },
  "model": "rootsys/kimi-k3",
  "small_model": "rootsys/glm-5.3-flash",
  "mcp": {
    "aztra": {
      "type": "remote",
      "url": "https://aztra.my/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "{file:~/.config/opencode/aztra.key}",
        "Accept": "application/json, text/event-stream"
      }
    }
  }
}
